# Pythonが自動生成するバイトコード。
# ソースから作り直せるうえ、Pythonのバージョンが変わると
# 別名のファイル(cpython-311 / cpython-312 …)が増え続けるので追跡しない。
__pycache__/
*.py[cod]

# 実行時に書かれる動作ログ。日付ごとに新しいファイルが増える運用データで、
# ソースの成果物ではない(既に追跡済みのファイルはそのまま残る)。
logs/*.log

# 手元の業務DB。**取り込みで作り直せる運用データ**で、ソースではない。
#
# 追跡していたころは 2.1MB の中身(仕掛ロット2159件・仕掛受注5720件…)が
# リポジトリに入り、しかもアプリを動かすたびに書き換わっていた。
# **開くだけでも** `PRAGMA journal_mode=WAL` がファイルを変えるので、
# 起動しただけで差分が出る。試験がここを汚さないよう
# `tests/_isolation.py` を書く羽目になったのもこれが理由。
#
# 無ければ起動時に `schema.sql` から作られる(`start_app.py` の
# `_initialize`)。手で作るなら `python scripts/init_db.py`。
data/*.db
data/*.db-wal
data/*.db-shm

# 利用者設定。**端末ごとの上書き**で、ソースではない。
#
# 既定値は `packaging_tool/config.py` が持っていて、そちらが**本番の値**。
# このファイルは設定画面(または環境変数)で既定を上書きしたときにできる。
#
# 追跡していたころは、開発用に向けた一時パスがそのまま入っていて、
# **配布したら本番端末が開発用の共有を見に行く**状態だった。
# 書き戻し(`write_back`)もそちらへ行くので、実害が出る。
data/user_config.json

# 配置編集で「配置を保存」したときの図。**現場ごとの配置**で、ソースでは
# ない。出荷時の配置は `packaging_tool/*_default.json` が持つ。
# 追跡すると、開発で動かした配置が配布に混ざり、現場の配置を上書きする
data/floor_plan.json
data/pallet_map.json

# 配布設定。**配る人がその場で書き出すもの**で、ソースではない
# (開発機の置き場所やパスワードの撹拌値が入る)
config/distribution.json
config/distribution.tmp

# CSVなどの書き出し先(既定)。出したものは端末ごとの成果物で、
# 配るものではない
export/

# 試験の網羅率を測ったときにできる作業ファイル。**配るものではない**
# (一度 `git add -A` で紛れ込んで、現場のフォルダに入った)
.coverage
.coverage.*
htmlcov/
.pytest_cache/
